{
  "computer": {
    "description": "Client-executed desktop tools. Use full screenshot pixel coordinates (origin top left), even after zoom. Run actions in returned order; inspect screenshots to verify outcomes.",
    "members": [
      {"name":"screenshot","description":"Return a full-display screenshot from the client.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"zoom","description":"Inspect a screenshot region at full resolution. Coordinates remain relative to the full screenshot.","parameters":{"type":"object","properties":{"region":{"type":"array","items":{"type":"integer","minimum":0},"minItems":4,"maxItems":4,"description":"Full screenshot pixel bounds [x0,y0,x1,y1], independent of zoom."}},"required":["region"],"additionalProperties":false},"enabled":true},
      {"name":"left_click","description":"left click at coordinate, or the current cursor if omitted.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string","description":"Optional modifier chord, e.g. ctrl+shift."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"right_click","description":"right click at coordinate, or the current cursor if omitted.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string","description":"Optional modifier chord, e.g. ctrl+shift."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"middle_click","description":"middle click at coordinate, or the current cursor if omitted.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string","description":"Optional modifier chord, e.g. ctrl+shift."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"double_click","description":"double click at coordinate, or the current cursor if omitted.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string","description":"Optional modifier chord, e.g. ctrl+shift."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"triple_click","description":"triple click at coordinate, or the current cursor if omitted.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string","description":"Optional modifier chord, e.g. ctrl+shift."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"left_click_drag","description":"Drag from start_coordinate to coordinate; text optionally holds modifier keys.","parameters":{"type":"object","properties":{"start_coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string"}},"required":["start_coordinate","coordinate"],"additionalProperties":false},"enabled":true},
      {"name":"mouse_move","description":"Move the mouse to full-display screenshot coordinates.","parameters":{"type":"object","properties":{"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2}},"required":["coordinate"],"additionalProperties":false},"enabled":true},
      {"name":"left_mouse_down","description":"Hold the left mouse button at the current cursor.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"left_mouse_up","description":"Release the left mouse button.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"cursor_position","description":"Report the current cursor coordinates.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"scroll","description":"Scroll by wheel clicks at coordinate or the current cursor; text optionally holds modifier keys.","parameters":{"type":"object","properties":{"scroll_direction":{"type":"string","enum":["up","down","left","right"]},"scroll_amount":{"type":"integer","minimum":1},"coordinate":{"type":"array","items":{"type":"integer","minimum":0},"minItems":2,"maxItems":2},"text":{"type":"string"}},"required":["scroll_direction","scroll_amount"],"additionalProperties":false},"enabled":true},
      {"name":"type","description":"Type literal text at the current focus.","parameters":{"type":"object","properties":{"text":{"type":"string"}},"required":["text"],"additionalProperties":false},"enabled":true},
      {"name":"key","description":"Press a key/chord such as Return or ctrl+s. Repeat defaults to 1.","parameters":{"type":"object","properties":{"text":{"type":"string"},"repeat":{"type":"integer","minimum":1,"maximum":100}},"required":["text"],"additionalProperties":false},"enabled":true},
      {"name":"hold_key","description":"Hold a key/chord for duration seconds.","parameters":{"type":"object","properties":{"text":{"type":"string"},"duration":{"type":"number","minimum":0,"maximum":300}},"required":["text","duration"],"additionalProperties":false},"enabled":true},
      {"name":"wait","description":"Wait duration seconds before the next action.","parameters":{"type":"object","properties":{"duration":{"type":"number","minimum":0,"maximum":300}},"required":["duration"],"additionalProperties":false},"enabled":true}
    ]
  },
  "browser": {
    "description": "Client-executed browser tools. Targets use viewport pixels or element refs from read_page/find. Keep tab_id when working across tabs; omitted tab_id means the active tab. Execute actions in returned order and verify results.",
    "members": [
      {"name":"navigate","description":"Load an HTTP(S) URL, or use back, forward, reload. URLs without scheme use HTTPS.","parameters":{"type":"object","properties":{"url":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["url"],"additionalProperties":false},"enabled":true},
      {"name":"screenshot","description":"Return the current viewport screenshot.","parameters":{"type":"object","properties":{"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"zoom","description":"Inspect a viewport region at full resolution; later coordinates still use the full viewport.","parameters":{"type":"object","properties":{"region":{"type":"array","items":{"type":"integer","minimum":0},"minItems":4,"maxItems":4,"description":"Full screenshot pixel bounds [x0,y0,x1,y1], independent of zoom."},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["region"],"additionalProperties":false},"enabled":true},
      {"name":"left_click","description":"left click at a viewport coordinate or a known element ref; modifiers optionally holds a chord.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"modifiers":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"right_click","description":"right click at a viewport coordinate or a known element ref; modifiers optionally holds a chord.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"modifiers":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"middle_click","description":"middle click at a viewport coordinate or a known element ref; modifiers optionally holds a chord.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"modifiers":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"double_click","description":"double click at a viewport coordinate or a known element ref; modifiers optionally holds a chord.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"modifiers":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"triple_click","description":"triple click at a viewport coordinate or a known element ref; modifiers optionally holds a chord.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"modifiers":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"hover","description":"Hover over the target.","parameters":{"type":"object","properties":{"target":{"anyOf":[{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false}]},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"left_click_drag","description":"Drag from the starting coordinate to the target coordinate.","parameters":{"type":"object","properties":{"from":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"target":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["from","target"],"additionalProperties":false},"enabled":true},
      {"name":"left_mouse_down","description":"left mouse down at the viewport coordinate.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"left_mouse_up","description":"left mouse up at the viewport coordinate.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"mouse_move","description":"mouse move at the viewport coordinate.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"scroll","description":"Scroll at the target by scroll-wheel notches, default 3.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"coordinate","type":"string"},"x":{"type":"integer","minimum":0},"y":{"type":"integer","minimum":0}},"required":["type","x","y"],"additionalProperties":false},"scroll_direction":{"type":"string","enum":["up","down","left","right"]},"scroll_amount":{"type":"integer","minimum":1,"maximum":10},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target","scroll_direction"],"additionalProperties":false},"enabled":true},
      {"name":"scroll_to","description":"Bring a known element ref into view.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false},"enabled":true},
      {"name":"type","description":"Type literal text into the current focus.","parameters":{"type":"object","properties":{"text":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["text"],"additionalProperties":false},"enabled":true},
      {"name":"key","description":"Press a key, chord, or space-separated key sequence. Repeat defaults to 1.","parameters":{"type":"object","properties":{"text":{"type":"string"},"repeat":{"type":"integer","minimum":1,"maximum":100},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["text"],"additionalProperties":false},"enabled":true},
      {"name":"hold_key","description":"Hold a key/chord for duration seconds.","parameters":{"type":"object","properties":{"text":{"type":"string"},"duration":{"type":"number","minimum":0,"maximum":30},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["text","duration"],"additionalProperties":false},"enabled":true},
      {"name":"wait","description":"Wait duration seconds.","parameters":{"type":"object","properties":{"duration":{"type":"number","minimum":0,"maximum":30},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["duration"],"additionalProperties":false},"enabled":true},
      {"name":"read_page","description":"Read the accessibility tree with element refs. Omit filter for visible elements; interactive restricts to visible controls; all includes offscreen elements. Depth defaults to 15; ref scopes to a subtree. Narrow the read if output is truncated.","parameters":{"type":"object","properties":{"filter":{"type":"string","enum":["interactive","all"]},"depth":{"type":"integer","minimum":1},"ref":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"find","description":"Find elements by natural-language description and return their refs.","parameters":{"type":"object","properties":{"query":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["query"],"additionalProperties":false},"enabled":true},
      {"name":"get_page_text","description":"Read the visible page text, prioritizing the main content.","parameters":{"type":"object","properties":{"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"form_input","description":"Set a form control. Use booleans for checkboxes and option text/value for selects.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false},"value":{"type":["string","number","boolean"]},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target","value"],"additionalProperties":false},"enabled":true},
      {"name":"file_upload","description":"Upload executor-local paths or staged document_ids. Supply at least one nonempty list.","parameters":{"type":"object","properties":{"target":{"type":"object","properties":{"type":{"const":"ref","type":"string"},"ref":{"type":"string"}},"required":["type","ref"],"additionalProperties":false},"paths":{"type":"array","items":{"type":"string"},"minItems":1},"document_ids":{"type":"array","items":{"type":"string"},"minItems":1},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["target"],"additionalProperties":false,"anyOf":[{"required":["paths"]},{"required":["document_ids"]}]},"enabled":false},
      {"name":"read_console","description":"Read console entries since the previous read.","parameters":{"type":"object","properties":{"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":[],"additionalProperties":false},"enabled":false},
      {"name":"read_network","description":"Read network requests since the previous read.","parameters":{"type":"object","properties":{"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":[],"additionalProperties":false},"enabled":false},
      {"name":"javascript_exec","description":"Execute JavaScript in the page and return the last expression as text.","parameters":{"type":"object","properties":{"text":{"type":"string"},"tab_id":{"type":"string","description":"Defaults to the active tab."}},"required":["text"],"additionalProperties":false},"enabled":false},
      {"name":"new_tab","description":"Create and activate a tab.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"list_tabs","description":"List tabs and identify the active tab.","parameters":{"type":"object","properties":{},"required":[],"additionalProperties":false},"enabled":true},
      {"name":"switch_tab","description":"Activate a tab.","parameters":{"type":"object","properties":{"tab_id":{"type":"string"}},"required":["tab_id"],"additionalProperties":false},"enabled":true},
      {"name":"close_tab","description":"Close a tab.","parameters":{"type":"object","properties":{"tab_id":{"type":"string"}},"required":["tab_id"],"additionalProperties":false},"enabled":true}
    ]
  }
}
